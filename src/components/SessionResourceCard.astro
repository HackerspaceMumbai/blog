---
import {
  getResourceChipLabel,
  type ArchiveSpeakerResourceType,
  type SessionResourceGroup,
} from '../utils/pastEventArchive';
import {
  getPremiereTimeBounds,
  getPremiereWatchLabel,
  isPremiereSession,
  resolvePremiereState,
  type FeaturedSessionPremiere,
} from '../utils/premiere';

interface Props {
  session: SessionResourceGroup;
  premiere?: FeaturedSessionPremiere | null;
}

const { session, premiere = null } = Astro.props;

const showPremiereChip = isPremiereSession(
  { title: session.title, speakers: session.speakers },
  premiere
);
const premiereBounds = showPremiereChip ? getPremiereTimeBounds(premiere) : null;
const premiereState = resolvePremiereState(premiere);
const premiereChipLabel = getPremiereWatchLabel(premiereState);

const chipClass =
  'inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium rounded-lg border border-primary/40 text-primary hover:bg-primary hover:text-primary-content transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-base-100';

const premiereChipClass =
  'inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-semibold rounded-lg bg-primary text-primary-content hover:bg-primary-focus transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-base-100';
---

<article
  class="rounded-xl border border-base-300 bg-base-100 p-5 sm:p-6"
  aria-labelledby={`session-${session.title.toLowerCase().replace(/[^\w]+/g, '-').replace(/^-|-$/g, '')}`}
>
  <h3
    id={`session-${session.title.toLowerCase().replace(/[^\w]+/g, '-').replace(/^-|-$/g, '')}`}
    class="text-xl font-bold text-base-content mb-3"
  >
    {session.title}
  </h3>

  <p class="text-sm text-base-content/70 mb-4">
    <span class="font-semibold text-base-content/80">
      {session.speakers.length > 1 ? 'Speakers' : 'Speaker'}
    </span>
    <br />
    {session.speakers.join(', ')}
  </p>

  {session.description && (
    <p class="text-sm text-base-content/75 mb-4">
      {session.description}
    </p>
  )}

  {(session.resources.length > 0 || (showPremiereChip && premiere && premiereBounds)) && (
    <div>
      <p class="text-sm font-semibold text-base-content/80 mb-2">Resources</p>
      <div class="flex flex-wrap gap-2">
        {session.resources.map((resource) => (
          <a
            href={resource.resourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class={chipClass}
            aria-label={`Open ${getResourceChipLabel(resource.resourceType as ArchiveSpeakerResourceType)} for ${session.title} (opens in new window)`}
          >
            {getResourceChipLabel(resource.resourceType as ArchiveSpeakerResourceType)}
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        ))}

        {showPremiereChip && premiere && premiereBounds && (
          <a
            href={premiere.watchUrl}
            target="_blank"
            rel="noopener noreferrer"
            class={premiereChipClass}
            data-premiere-promo
            data-start-at={String(premiereBounds.startMs)}
            data-end-at={String(premiereBounds.endMs)}
            aria-label={`${premiereChipLabel} on YouTube for ${session.title} (opens in new window)`}
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21.6 7.2a2.7 2.7 0 0 0-1.9-1.9C18 4.8 12 4.8 12 4.8s-6 0-7.7.5A2.7 2.7 0 0 0 2.4 7.2 28 28 0 0 0 1.9 12c0 1.6.2 3.2.5 4.8a2.7 2.7 0 0 0 1.9 1.9c1.7.5 7.7.5 7.7.5s6 0 7.7-.5a2.7 2.7 0 0 0 1.9-1.9c.3-1.6.5-3.2.5-4.8s-.2-3.2-.5-4.8ZM10.1 15.1V8.9l5.1 3.1-5.1 3.1Z" />
            </svg>
            <span
              data-premiere-label
              data-label-upcoming="Watch Premiere"
              data-label-live="Watch Premiere"
              data-label-post="Watch Recording"
            >
              {premiereChipLabel}
            </span>
          </a>
        )}
      </div>
    </div>
  )}
</article>

{showPremiereChip && premiereBounds && <script src="/scripts/premiere-promo.js" defer></script>}
