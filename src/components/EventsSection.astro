---
import CTAButton from './CTAButton.astro';
import EventCard from './EventCard.astro';
import RecentEventCard from './RecentEventCard.astro';
import SectionHeading from './SectionHeading.astro';
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import {
  formatHostedEventsStat,
  getGridClasses,
  getSortedRecentEvents,
  shouldShowRecentFallback,
  validateUpcomingEvents,
} from '../utils/eventsSection';

export interface Event {
  title: string;
  date: string;
  location: string;
  description: string;
  rsvpLink: string;
  coverImage?: string | ImageMetadata;
  galleryPath?: string;
}

interface Props {
  events: Event[];
  /** Recent past events to show when no upcoming events exist */
  recentEvents?: CollectionEntry<'pastEvents'>[];
  /** Total events hosted count for the stat badge */
  totalEventsHosted?: number;
  /** Optional title override */
  title?: string;
  /** Optional CTA button text */
  ctaText?: string;
  /** Optional CTA button URL */
  ctaUrl?: string;
  /** Show recent events even when upcoming events exist */
  showRecentAlways?: boolean;
}

const {
  events,
  recentEvents = [],
  totalEventsHosted,
  title = "Upcoming Events",
  ctaText = "View All Events",
  ctaUrl = "https://www.meetup.com/mumbai-technology-meetup/events/",
  showRecentAlways = false,
} = Astro.props;

const statLabel = formatHostedEventsStat(totalEventsHosted);
const validatedEvents = validateUpcomingEvents<Event>(events);
const gridClasses = getGridClasses(validatedEvents.length);

// Sort and limit recent events to 3 most recent
const sortedRecentEvents = getSortedRecentEvents(recentEvents);
const showRecentFallback = shouldShowRecentFallback(validatedEvents.length, sortedRecentEvents.length);
const showRecentEvents = showRecentAlways
  ? sortedRecentEvents.length > 0
  : showRecentFallback;
const headingId = validatedEvents.length > 0 ? "upcoming-events" : "recent-events";
---
<section 
  class="events-listing home-gutter bg-base-100 text-base-content"
  aria-labelledby={headingId}
  role="region"
>
  <div class="home-column">
    <!-- Section Header -->
    <header class="mb-12 text-center">
      <SectionHeading 
        id={headingId} 
        level={2}
        class="text-3xl font-bold text-primary focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-background rounded-md"
      >
        {showRecentFallback ? "Recent Events" : title}
      </SectionHeading>

      {/* 100+ events stat badge — always visible */}
      {statLabel && (
        <p class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-primary/80 bg-primary/10 border border-primary/20 rounded-full px-3 py-1">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
          </svg>
          {statLabel}
        </p>
      )}

      <p class="mt-4 text-base-content/70 max-w-2xl mx-auto">
        {showRecentFallback
          ? "Catch up on what happened at our recent meetups and workshops"
          : "Join us for upcoming meetups, workshops, and community events in Mumbai"}
      </p>
    </header>

    {/* Upcoming events grid */}
    {validatedEvents.length > 0 && (
      <div 
        class={`grid ${gridClasses} gap-8 items-stretch mb-8`}
        role="list"
        aria-label={`${validatedEvents.length} upcoming event${validatedEvents.length === 1 ? '' : 's'} from Hackerspace Mumbai`}
        aria-live="polite"
        aria-busy="false"
      >
        {validatedEvents.map((event, index) => (
          <div 
            role="listitem"
            class="w-full max-w-3xl md:max-w-4xl mx-auto h-full"
            aria-setsize={validatedEvents.length}
            aria-posinset={index + 1}
          >
            <EventCard {...event} />
          </div>
        ))}
      </div>
    )}

    {showRecentEvents && validatedEvents.length > 0 && (
      <h3 id="recent-events" class="text-2xl font-bold text-primary mb-8 text-center">Recent Events</h3>
    )}

    {/* Recent events — fallback when none upcoming, or always on the events page */}
    {showRecentEvents && (
      <div 
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-8 items-stretch"
        role="list"
        aria-label="Recent past events from Hackerspace Mumbai"
      >
        {sortedRecentEvents.map((event) => (
          <div role="listitem" class="h-full">
            <RecentEventCard
              title={event.data.title}
              date={event.data.date}
              location={event.data.location}
              slug={event.slug}
              coverImage={event.data.coverImage}
              eventType={event.data.eventType}
            />
          </div>
        ))}
      </div>
    )}

    {/* Empty state — only when no upcoming and no recent events */}
    {validatedEvents.length === 0 && sortedRecentEvents.length === 0 && (
      <div 
        class="text-center py-16"
        role="status"
        aria-live="polite"
      >
        <div class="mb-4">
          <svg 
            class="w-16 h-16 mx-auto text-base-content/40" 
            fill="none" 
            stroke="currentColor" 
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-base-content mb-2">No upcoming events</h3>
        <p class="text-base-content/70">Check back soon for new meetups and activities from our community!</p>
      </div>
    )}

    {/* CTA Section */}
    <footer class="text-center mt-12 flex flex-col sm:flex-row gap-4 justify-center items-center">
      <CTAButton 
        href={ctaUrl} 
        variant="soft"
        target="_blank"
        aria-describedby="view-all-events-desc"
        aria-label="View all events (opens in new window)"
      >
        {ctaText}
      </CTAButton>
      <div class="hidden sm:block text-base-content/40">|</div>
      <CTAButton 
        href="/past-events" 
        variant="outline"
        aria-describedby="view-past-events-desc"
        aria-label="View past events and speaker resources"
      >
        Browse Past Events
      </CTAButton>
      <p 
        id="view-all-events-desc" 
        class="sr-only"
      >
        Navigate to the complete events archive to explore all upcoming and past events from Hackerspace Mumbai
      </p>
      <p 
        id="view-past-events-desc" 
        class="sr-only"
      >
        Browse our archive of past events and access speaker resources, slides, videos, and recordings
      </p>
    </footer>
  </div>
</section>

<style>
  .events-listing {
    padding-top: 2.5rem;
    padding-bottom: 4rem;
  }
</style>
