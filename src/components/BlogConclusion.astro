---
/**
 * Gives a post's closing section restrained visual separation from the sections before it.
 * In MDX, leave blank lines inside the tags so headings, lists, and blockquotes still parse.
 */
---

<section class="blog-conclusion">
  <slot />
</section>

<style>
  .blog-conclusion {
    margin-block: 3rem;
    padding: 2rem 1.75rem 0.5rem;
    border: 1px solid var(--color-base-300);
    border-radius: 0.75rem;
    background: var(--color-base-200);
  }

  .blog-conclusion > :global(:first-child) {
    margin-top: 0;
  }

  .blog-conclusion :global(blockquote:last-child) {
    border-left-color: var(--color-primary);
  }

  @media (max-width: 640px) {
    .blog-conclusion {
      padding: 1.5rem 1.125rem 0.25rem;
    }
  }
</style>
