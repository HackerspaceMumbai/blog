---
import CTAButton from './CTAButton.astro';
---

<section id="join" class="close-cta home-gutter" aria-labelledby="close-cta-heading">
  <div class="home-column close-cta-inner">
    <p class="close-cta-kicker">Your seat is waiting</p>
    <h2 id="close-cta-heading" class="close-cta-heading">
      <span class="close-cta-plain">Make a little room</span>
      <span class="close-cta-accent">for more.</span>
    </h2>
    <nav class="close-cta-links" aria-label="Ways to join">
      <a href="#join">Join community →</a>
      <a href="/events/">Attend an event →</a>
      <a href="/volunteer">Volunteer →</a>
      <a href="https://github.com/HackerspaceMumbai" target="_blank" rel="noopener noreferrer">
        Contribute to open source →
      </a>
    </nav>
    <CTAButton href="#join" variant="primary" extraClass="close-cta-button">
      Join Hackerspace Mumbai →
    </CTAButton>
  </div>
</section>

<style>
  .close-cta {
    padding-top: 4rem;
    padding-bottom: 4.5rem;
    background: var(--color-base-200);
    color: var(--color-base-content);
    text-align: center;
  }

  .close-cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .close-cta-kicker {
    margin: 0 0 1rem;
    color: var(--color-primary);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .close-cta-heading {
    margin: 0 0 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    line-height: 1.08;
  }

  .close-cta-plain {
    color: var(--color-base-content);
    font-size: clamp(1.85rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .close-cta-accent {
    color: var(--color-primary);
    font-family: 'Playfair Display', Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-weight: 500;
    font-size: clamp(2rem, 4.4vw, 3.15rem);
    letter-spacing: -0.02em;
  }

  .close-cta :global(.close-cta-button) {
    font-weight: 600;
  }

  .close-cta-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1.35rem;
    margin: 0 0 1.75rem;
  }

  .close-cta-links a {
    color: var(--color-base-content);
    opacity: 0.75;
    font-size: 0.9rem;
    text-decoration: none;
  }

  .close-cta-links a:hover {
    color: var(--color-primary);
    opacity: 1;
  }

  @media (min-width: 900px) {
    .close-cta {
      padding-top: 5.5rem;
      padding-bottom: 6rem;
    }
  }
</style>
