---
import NewsletterForm from './NewsletterForm.astro';

const topics = [
  { label: 'Events', href: '/events/' },
  { label: 'Community stories', href: '/blog/' },
  { label: 'Volunteer opportunities', href: '/volunteer' },
  { label: 'Open source projects', href: 'https://github.com/HackerspaceMumbai', external: true },
  { label: 'Community updates', href: '/#newsletter' },
];
---

<section id="newsletter" class="newsletter-section home-gutter" aria-labelledby="newsletter-heading">
  <div class="home-column newsletter-layout">
    <div class="newsletter-copy">
      <p class="newsletter-kicker">The next chapter</p>
      <h2 id="newsletter-heading" class="newsletter-heading">Keep building with us.</h2>
      <p class="newsletter-lede">
        Join thousands of builders, contributors, volunteers, mentors, speakers, and learners.
      </p>
      <p class="newsletter-topics">
        {topics.map((topic, index) => (
          <>
            {index > 0 && <span aria-hidden="true"> · </span>}
            <a
              href={topic.href}
              target={topic.external ? '_blank' : undefined}
              rel={topic.external ? 'noopener noreferrer' : undefined}
            >
              {topic.label}
            </a>
          </>
        ))}
      </p>
    </div>

    <div class="newsletter-form-shell">
      <NewsletterForm
        formId="newsletter-section-form"
        placeholder="you@example.com"
        buttonText="Join the community →"
        className="mt-0"
        variant="minimal"
      />
    </div>
  </div>
</section>

<style>
  .newsletter-section {
    padding-top: 4rem;
    padding-bottom: 4rem;
    background: var(--color-base-100);
    color: var(--color-base-content);
  }

  .newsletter-layout {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  .newsletter-kicker {
    margin: 0 0 1rem;
    color: var(--color-primary);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .newsletter-heading {
    margin: 0 0 1rem;
    color: var(--color-base-content);
    font-size: clamp(1.85rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .newsletter-lede {
    margin: 0 0 1.75rem;
    max-width: 28rem;
    color: var(--color-base-content);
    opacity: 0.7;
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .newsletter-topics {
    margin: 0;
    max-width: 28rem;
    color: var(--color-base-content);
    opacity: 0.45;
    font-size: 0.8rem;
    line-height: 1.7;
  }

  .newsletter-topics a {
    color: inherit;
    text-decoration: none;
  }

  .newsletter-topics a:hover {
    color: var(--color-primary);
    opacity: 1;
  }

  .newsletter-form-shell {
    width: 100%;
    padding: 1.6rem 1.4rem 1.4rem;
    border-radius: 0.5rem;
    border: 1px solid color-mix(in oklab, var(--color-base-content) 14%, transparent);
    background: color-mix(in oklab, var(--color-base-200) 80%, transparent);
  }

  @media (min-width: 900px) {
    .newsletter-section {
      padding-top: 5.5rem;
      padding-bottom: 5.5rem;
    }

    .newsletter-layout {
      grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.9fr);
      gap: 5rem;
      align-items: center;
    }

    .newsletter-form-shell {
      padding: 2rem 1.75rem 1.65rem;
    }
  }
</style>
