---
import CTAButton from './CTAButton.astro';

interface Props {
  title: string;
  date: string;
  location: string;
  description: string;
  rsvpLink: string;
  image: ImageMetadata;
  kicker?: string;
  sectionId?: string;
}

const {
  title,
  date,
  location,
  description,
  rsvpLink,
  image,
  kicker = 'Upcoming event',
  sectionId = 'events',
} = Astro.props;
---

<section id={sectionId} class="home-gutter py-2 md:py-3" aria-labelledby="featured-event-heading">
  <div class="event-banner home-column">
    <img
      src={image.src}
      alt=""
      width={image.width}
      height={image.height}
      class="event-banner-photo"
      decoding="async"
    />
    <div class="event-banner-overlay" aria-hidden="true"></div>
    <div class="event-banner-copy">
      <p class="event-banner-kicker">{kicker}</p>
      <h2 id="featured-event-heading" class="event-banner-title">{title}</h2>
      <p class="event-banner-meta">{date} · {location}</p>
      <p class="event-banner-lede">{description}</p>
      <CTAButton
        href={rsvpLink}
        variant="primary"
        target="_blank"
        aria-label={`Register for ${title} (opens in new window)`}
      >
        Register →
      </CTAButton>
    </div>
  </div>
</section>

<style>
  .event-banner {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: 20rem;
    overflow: hidden;
    border-radius: 0.75rem;
    background-color: #08060e;
  }

  .event-banner-photo {
    position: absolute !important;
    inset: 0 !important;
    z-index: 0;
    display: block;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    max-height: none !important;
    object-fit: cover !important;
    object-position: center right !important;
    pointer-events: none;
  }

  .event-banner-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      90deg,
      rgb(8 6 14 / 0.55) 0%,
      rgb(8 6 14 / 0.35) 55%,
      rgb(8 6 14 / 0.1) 78%,
      transparent 92%
    );
  }

  .event-banner-copy {
    position: relative;
    z-index: 2;
    max-width: min(36rem, 68%);
    padding: 2.25rem 0;
  }

  @media (max-width: 640px) {
    .event-banner-copy {
      max-width: 100%;
      padding-right: 1rem;
    }

    /*
     * At narrow widths the copy spans the full banner, so a left-to-right
     * gradient can no longer guarantee contrast against the (still
     * right-anchored) artwork crop. Switch to a near-solid backdrop so
     * legibility never depends on how much bright artwork the crop shows.
     */
    .event-banner-overlay {
      background: rgb(8 6 14 / 0.78);
    }
  }

  .event-banner-kicker {
    margin: 0 0 0.75rem;
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .event-banner-title {
    margin: 0 0 0.75rem;
    color: #ffffff;
    font-size: clamp(1.75rem, 3.6vw, 2.75rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .event-banner-meta {
    margin: 0 0 1rem;
    color: rgb(255 255 255 / 0.78);
    font-size: 0.95rem;
  }

  .event-banner-lede {
    margin: 0 0 1.5rem;
    color: rgb(255 255 255 / 0.88);
    font-size: 1rem;
    line-height: 1.65;
  }

  @media (min-width: 900px) {
    .event-banner {
      min-height: 24rem;
    }

    .event-banner-copy {
      padding: 3rem 0 3rem 0;
    }
  }
</style>
