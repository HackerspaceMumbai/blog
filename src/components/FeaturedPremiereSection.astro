---
import type { FeaturedSessionPremiere } from '../utils/premiere';
import { getPremiereTimeBounds, getPremiereWatchLabel, resolvePremiereState } from '../utils/premiere';

interface Props {
  premiere: FeaturedSessionPremiere;
}

const { premiere } = Astro.props as Props;

const bounds = getPremiereTimeBounds(premiere);
const state = resolvePremiereState(premiere);

const premiereDate = new Date(premiere.startAt);
const formattedDateTime = new Intl.DateTimeFormat('en-IN', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  hour: 'numeric',
  minute: '2-digit',
  hour12: true,
  timeZone: 'Asia/Kolkata',
}).format(premiereDate);

const watchLabel = getPremiereWatchLabel(state);
---

{bounds && (
  <section
    class="rounded-xl border-2 border-primary bg-primary/5 p-6 sm:p-8"
    aria-labelledby="featured-premiere-heading"
    data-premiere-promo
    data-start-at={String(bounds.startMs)}
    data-end-at={String(bounds.endMs)}
  >
    <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] lg:items-start">
      <a
        href={premiere.watchUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group block overflow-hidden rounded-lg border border-base-300 bg-base-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        aria-label={`${watchLabel} on YouTube: ${premiere.sessionTitle} (opens in new window)`}
      >
        {premiere.thumbnailUrl ? (
          <img
            src={premiere.thumbnailUrl}
            alt={premiere.thumbnailAlt ?? premiere.sessionTitle}
            width="1280"
            height="720"
            loading="eager"
            class="aspect-video w-full object-cover transition-transform duration-300 group-hover:scale-105"
          />
        ) : (
          <div class="flex aspect-video w-full items-center justify-center text-base-content/60">
            YouTube Premiere
          </div>
        )}
      </a>

      <div>
        <div class="flex flex-wrap items-center gap-3">
          <span
            class="inline-flex items-center gap-2 rounded-full bg-primary px-3 py-1 text-sm font-bold text-primary-content"
            data-premiere-label
            data-label-upcoming="🚀 PREMIERING TONIGHT"
            data-label-live="🔴 PREMIERING NOW"
            data-label-post="▶ SESSION RECORDING"
          >
            {state === 'live' ? '🔴 PREMIERING NOW' : state === 'post' ? '▶ SESSION RECORDING' : '🚀 PREMIERING TONIGHT'}
          </span>

          <span class="inline-flex items-center gap-1.5 rounded-full border border-base-300 px-3 py-1 text-xs font-semibold text-base-content/70">
            <svg class="h-3.5 w-3.5 text-error" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21.6 7.2a2.7 2.7 0 0 0-1.9-1.9C18 4.8 12 4.8 12 4.8s-6 0-7.7.5A2.7 2.7 0 0 0 2.4 7.2 28 28 0 0 0 1.9 12c0 1.6.2 3.2.5 4.8a2.7 2.7 0 0 0 1.9 1.9c1.7.5 7.7.5 7.7.5s6 0 7.7-.5a2.7 2.7 0 0 0 1.9-1.9c.3-1.6.5-3.2.5-4.8s-.2-3.2-.5-4.8ZM10.1 15.1V8.9l5.1 3.1-5.1 3.1Z" />
            </svg>
            YouTube Premiere
          </span>
        </div>

        <p class="mt-4 text-sm font-semibold text-primary">
          {formattedDateTime} IST
        </p>

        <div class="mt-2" data-premiere-state="upcoming" aria-hidden={state === 'upcoming' ? 'false' : 'true'}>
          <p class="font-mono text-lg font-bold text-base-content" data-premiere-countdown>--d : --h : --m : --s</p>
          <p class="sr-only" aria-live="polite" data-premiere-countdown-a11y></p>
        </div>

        <h3 id="featured-premiere-heading" class="mt-3 text-2xl font-bold text-base-content sm:text-3xl">
          {premiere.sessionTitle}
        </h3>

        <p class="mt-2 text-base font-semibold text-base-content/90">
          {premiere.speakerName}
        </p>
        {premiere.speakerTitle && (
          <p class="text-sm text-base-content/70">{premiere.speakerTitle}</p>
        )}

        <p class="mt-4 text-sm text-base-content/80">
          {premiere.description}
        </p>

        <div class="mt-6 flex flex-wrap items-center gap-4">
          <a
            href={premiere.watchUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg bg-primary px-5 py-2.5 font-semibold text-primary-content transition-colors hover:bg-primary-focus focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21.6 7.2a2.7 2.7 0 0 0-1.9-1.9C18 4.8 12 4.8 12 4.8s-6 0-7.7.5A2.7 2.7 0 0 0 2.4 7.2 28 28 0 0 0 1.9 12c0 1.6.2 3.2.5 4.8a2.7 2.7 0 0 0 1.9 1.9c1.7.5 7.7.5 7.7.5s6 0 7.7-.5a2.7 2.7 0 0 0 1.9-1.9c.3-1.6.5-3.2.5-4.8s-.2-3.2-.5-4.8ZM10.1 15.1V8.9l5.1 3.1-5.1 3.1Z" />
            </svg>
            <span
              data-premiere-label
              data-label-upcoming="Watch YouTube Premiere"
              data-label-live="Watch YouTube Premiere"
              data-label-post="Watch Recording"
            >
              {state === 'post' ? 'Watch Recording' : 'Watch YouTube Premiere'}
            </span>
          </a>

          <p class="text-sm text-base-content/70">
            View session resources, slides, and event materials below.
          </p>
        </div>
      </div>
    </div>
  </section>
)}

{bounds && <script src="/scripts/premiere-promo.js" defer></script>}
