---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'img'>, 'src' | 'width' | 'height'> {
  src: ImageMetadata;
  alt: string;
  width?: number;
  height?: number;
  quality?: number;
  widths?: number[];
  sizes?: string;
}

const {
  quality = 80,
  widths = [400, 800, 1200, 1600],
  sizes = '(min-width: 800px) 768px, calc(100vw - 32px)',
  ...props
} = Astro.props;
---

<Image {...props} quality={quality} widths={widths} sizes={sizes} />
