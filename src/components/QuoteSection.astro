<section class="quote-section home-gutter" aria-labelledby="member-quote">
  <figure class="quote-frame home-column">
    <blockquote>
      <p id="member-quote" class="quote-text">
        “The best part is that nobody asks you to have it all figured out before you start.”
      </p>
    </blockquote>
    <figcaption class="quote-attrib">— Rhea, community member since 2023</figcaption>
  </figure>
</section>

<style>
  .quote-section {
    padding-top: 4rem;
    padding-bottom: 4rem;
    background: var(--color-base-100);
    color: var(--color-base-content);
    text-align: center;
  }

  .quote-text {
    margin: 0 auto 1.25rem;
    max-width: 40rem;
    color: var(--color-base-content);
    font-family: 'Playfair Display', Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.5rem, 3.4vw, 2.35rem);
    line-height: 1.35;
    letter-spacing: -0.02em;
  }

  .quote-attrib {
    margin: 0;
    color: var(--color-base-content);
    opacity: 0.5;
    font-size: 0.85rem;
  }

  @media (min-width: 900px) {
    .quote-section {
      padding-top: 5.5rem;
      padding-bottom: 5.5rem;
    }
  }
</style>
