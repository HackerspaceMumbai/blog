---
/**
 * Presents a structured domain or UI example (a record, form, or card) so it reads
 * differently from syntax-highlighted source code.
 */
interface Props {
  label: string;
  fields: { name: string; value: string }[];
  /** Optional illustrative action shown as a non-interactive button label. */
  action?: string;
}

const { label, fields, action } = Astro.props;
---

<figure class="blog-record not-prose">
  <figcaption class="blog-record__label">{label}</figcaption>
  <dl class="blog-record__fields">
    {fields.map(({ name, value }) => (
      <div class="blog-record__row">
        <dt>{name}</dt>
        <dd>{value}</dd>
      </div>
    ))}
  </dl>
  {action && <p class="blog-record__action"><span>{action}</span></p>}
</figure>

<style>
  .blog-record {
    margin: 1.75rem 0;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--color-base-300);
    border-left: 4px solid var(--color-primary);
    border-radius: 0.5rem;
    background: var(--color-base-200);
    color: var(--color-base-content);
  }

  .blog-record__label {
    margin: 0 0 0.875rem;
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .blog-record__fields {
    display: grid;
    gap: 0.5rem;
    margin: 0;
  }

  .blog-record__row {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1rem;
  }

  .blog-record dt {
    color: color-mix(in oklab, var(--color-base-content) 72%, transparent);
    font-size: 0.9375rem;
  }

  .blog-record dd {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
  }

  .blog-record__action {
    margin: 1.125rem 0 0;
  }

  .blog-record__action span {
    display: inline-block;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    background: var(--color-primary);
    color: var(--color-primary-content);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  @media (max-width: 480px) {
    .blog-record {
      padding: 1rem 1.125rem;
    }

    .blog-record__row {
      grid-template-columns: 1fr;
      gap: 0.125rem;
    }
  }
</style>
