---
// SpeakerResourceCard.astro: Renders a single speaker resource card

export interface SpeakerResourceCardProps {
  speakerName: string;
  resourceTitle: string;
  resourceUrl: string;
  resourceType: "slides" | "video" | "recording" | "documentation" | "blog" | "github" | "other";
  description?: string;
}

const { speakerName, resourceTitle, resourceUrl, resourceType, description } = Astro.props;

// Map resource types to icons, high-contrast colors, and tinted surfaces
const resourceConfig = {
  slides: {
    icon: "presentation",
    color: "text-blue-600 dark:text-blue-300",
    surface: "bg-blue-500/15 dark:bg-blue-400/20",
    label: "Slides",
    filled: false,
  },
  video: {
    icon: "play",
    color: "text-red-600 dark:text-red-300",
    surface: "bg-red-500/15 dark:bg-red-400/20",
    label: "Video",
    filled: false,
  },
  recording: {
    icon: "video",
    color: "text-purple-600 dark:text-purple-300",
    surface: "bg-purple-500/15 dark:bg-purple-400/20",
    label: "Recording",
    filled: false,
  },
  documentation: {
    icon: "document",
    color: "text-green-700 dark:text-green-300",
    surface: "bg-green-500/15 dark:bg-green-400/20",
    label: "Documentation",
    filled: false,
  },
  blog: {
    icon: "post",
    color: "text-amber-700 dark:text-amber-300",
    surface: "bg-amber-500/15 dark:bg-amber-400/20",
    label: "Blog Post",
    filled: false,
  },
  github: {
    icon: "github",
    color: "text-base-content",
    surface: "bg-base-content/10",
    label: "GitHub",
    filled: true,
  },
  other: {
    icon: "link",
    color: "text-base-content",
    surface: "bg-base-content/10",
    label: "Resource",
    filled: false,
  },
};

const config = resourceConfig[resourceType];

const iconSVGs: Record<string, string> = {
  presentation:
    '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10M12 15v6m-7-6h14a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v9a1 1 0 001 1z"/>',
  play: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>',
  video:
    '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>',
  document:
    '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6M9 17h4"/>',
  post: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V9a2 2 0 012-2h2a2 2 0 012 2v9a2 2 0 01-2 2h-2z"/>',
  github:
    '<path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>',
  link: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>',
};
---

<div 
  class="resource-card group flex gap-3 p-4 rounded-lg border border-base-300 bg-base-50 hover:bg-base-100 hover:border-primary/50 hover:shadow-md transition-all duration-200"
  role="article"
  aria-label={`${resourceType}: ${resourceTitle} by ${speakerName}`}
>
  <!-- Resource Type Icon: compact box, larger glyph, high contrast -->
  <div
    class={`flex-shrink-0 flex items-center justify-center size-10 rounded-md ${config.surface} ${config.color} group-hover:brightness-110 transition-[filter]`}
    aria-hidden="true"
  >
    <svg
      class="size-6"
      viewBox="0 0 24 24"
      fill={config.filled ? "currentColor" : "none"}
      stroke={config.filled ? "none" : "currentColor"}
      aria-hidden="true"
    >
      <Fragment set:html={iconSVGs[config.icon]} />
    </svg>
  </div>

  <!-- Resource Content -->
  <div class="flex-grow min-w-0">
    <div class="flex items-start gap-2 mb-1">
      <span class="inline-block px-2 py-0.5 text-xs font-semibold rounded-full bg-primary/10 text-primary flex-shrink-0">
        {config.label}
      </span>
    </div>
    
    <h4 class="font-semibold text-base-content text-base mb-1 line-clamp-2 group-hover:text-primary transition-colors">
      {resourceTitle}
    </h4>
    
    <p class="text-sm text-base-content/60 mb-2">
      By <span class="font-medium">{speakerName}</span>
    </p>
    
    {description && (
      <p class="text-sm text-base-content/70 mb-3 line-clamp-2">
        {description}
      </p>
    )}
    
    <!-- Link -->
    <a 
      href={resourceUrl} 
      target="_blank" 
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1 text-sm font-medium text-primary hover:text-primary-focus hover:underline transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 rounded px-1"
      aria-label={`Open ${resourceTitle} (opens in new window)`}
    >
      View Resource
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4m-4-6l6 6m0 0l-6 6" />
      </svg>
    </a>
  </div>
</div>

