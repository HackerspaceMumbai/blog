---
// PastEventCard.astro: Renders a single past event card with speaker resources
import { Image } from 'astro:assets';
import SpeakerResourceCard from './SpeakerResourceCard.astro';
import { getArchiveLinks, isSafeArchiveUrl, type PastEventArchiveLinks } from '../utils/pastEventArchive';
import { resolveResourceUrl, getEventSlug, isValidResourceUrl } from '../utils/resourceUrl';
import type { ImageMetadata } from 'astro';

export interface SpeakerResource {
  speakerName: string;
  resourceTitle: string;
  resourceUrl: string;
  resourceType: "slides" | "video" | "recording" | "documentation" | "blog" | "github" | "other";
  description?: string;
}

export interface PastEventCardProps {
  title: string;
  date: Date;
  location: string;
  description: string;
  speakerResources?: SpeakerResource[];
  coverImage?: ImageMetadata;
  eventId?: string;
  slug?: string;
  archiveLinks?: PastEventArchiveLinks;
}

const { title, date, location, description, speakerResources = [], coverImage, eventId = '', slug = '', archiveLinks } = Astro.props;

// Format date
const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);

// Sanitize title for valid HTML ID (only ASCII alphanumerics and hyphens)
const sanitizedId = `event-${title
  .toLowerCase()
  .replace(/[^\w\s-]/g, '') // Remove special characters and emoji
  .replace(/\s+/g, '-')
  .replace(/-+/g, '-') // Replace multiple hyphens with single
  .replace(/^-|-$/g, '')}`;

// Extract event slug and resolve resource URLs
const eventSlug = getEventSlug(eventId);
const resolvedResources = speakerResources
  .filter(resource => isValidResourceUrl(resource.resourceUrl)) // Filter out invalid URLs
  .map(resource => ({
    ...resource,
    resourceUrl: resolveResourceUrl(resource.resourceUrl, eventSlug)
  }))
  .filter(resource => resource.resourceUrl); // Filter out resources with empty resolved URLs

const canonicalArchiveLinks = getArchiveLinks(archiveLinks);
const canonicalArchiveUrl = isSafeArchiveUrl(archiveLinks?.archiveUrl)
  ? archiveLinks.archiveUrl
  : undefined;
---

<article 
  class="card bg-base-100 border border-base-300 rounded-xl shadow-md hover:shadow-lg transition-shadow duration-300 overflow-hidden"
  role="article"
  aria-labelledby={sanitizedId}
>
  <!-- Event Header with Cover Image -->
  {coverImage && (
    <figure class="relative w-full h-64 overflow-hidden bg-base-200">
      <Image 
        src={coverImage} 
        alt={title}
        class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
        loading="lazy"
        widths={[400, 600, 800]}
        sizes="(max-width: 640px) 400px, (max-width: 1024px) 600px, 800px"
        format="webp"
        quality={80}
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none"></div>
    </figure>
  )}

  <!-- Event Details -->
  <div class="card-body">
    <div class="mb-2">
      <time 
        dateTime={date.toISOString()}
        class="text-sm font-semibold text-primary"
      >
        {formattedDate}
      </time>
    </div>
    
    <h3 
      id={sanitizedId}
      class="card-title text-2xl font-bold text-base-content mb-2 hover:text-primary transition-colors"
    >
      {title}
    </h3>

    <p class="text-sm text-base-content/70 mb-4 flex items-center gap-2">
      <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
        <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
      </svg>
      <span>{location}</span>
    </p>

    <p class="text-base text-base-content/80 mb-6">
      {description}
    </p>

    <!-- Event actions -->
    {(slug || canonicalArchiveLinks.length > 0) && (
      <div class="mb-6 flex flex-wrap gap-3">
        {slug && (
        <a
          href={`/past-events/${slug}/gallery/`}
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-primary text-primary hover:bg-primary hover:text-primary-content transition-colors duration-300"
          aria-label="View photos from this event"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" />
          </svg>
          View Photos
        </a>
        )}

        {canonicalArchiveUrl && (
          <a
            href={canonicalArchiveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-base-300 text-base-content hover:border-primary hover:text-primary transition-colors duration-300"
            aria-label="Open canonical event archive on GitHub"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 0C4.477 0 0 4.484 0 10.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.221-.253-4.555-1.113-4.555-4.952 0-1.094.39-1.988 1.03-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0110 4.344c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.594 1.028 2.688 0 3.848-2.337 4.696-4.566 4.944.359.31.679.92.679 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0020 10.017C20 4.484 15.522 0 10 0z" clip-rule="evenodd" />
            </svg>
            Canonical Archive
          </a>
        )}
      </div>
    )}

    {canonicalArchiveLinks.length > 0 && (
      <div class="mb-6 p-4 rounded-lg bg-base-200/60 border border-base-300">
        <h4 class="font-bold text-base text-base-content mb-3">Canonical Event Archive</h4>
        <p class="text-sm text-base-content/70 mb-4">
          Official media, recap, speaker details, resources, and community contributions live in the Hackerspace Mumbai events archive.
        </p>
        <div class="flex flex-wrap gap-2">
          {canonicalArchiveLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-xs btn-outline btn-primary"
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Speaker Resources Section -->
    {resolvedResources && resolvedResources.length > 0 && (
      <div class="mt-8">
        <h4 class="font-bold text-lg text-base-content mb-4 flex items-center gap-2">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v4h8v-4zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z" />
          </svg>
          Speaker Resources
        </h4>
        
        <div class="grid gap-3">
          {resolvedResources.map((resource) => (
            <SpeakerResourceCard 
              speakerName={resource.speakerName}
              resourceTitle={resource.resourceTitle}
              resourceUrl={resource.resourceUrl}
              resourceType={resource.resourceType}
              description={resource.description}
            />
          ))}
        </div>
      </div>
    )}

    {!resolvedResources || resolvedResources.length === 0 && (
      <div class="mt-8 p-4 rounded-lg bg-base-200/50 text-center">
        <p class="text-sm text-base-content/60">
          Speaker resources will be added soon.
        </p>
      </div>
    )}
  </div>
</article>
