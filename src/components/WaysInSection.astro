---
const ways = [
  {
    number: '01',
    title: 'Show up',
    description: 'Meet us at an event, workshop, or co-working session.',
    href: '/events/',
    external: false,
  },
  {
    number: '02',
    title: 'Give back',
    description: 'Share your knowledge and make the room warmer.',
    href: '#join',
    external: false,
  },
  {
    number: '03',
    title: 'Build something',
    description: 'Find an open project and add your perspective.',
    href: 'https://github.com/HackerspaceMumbai',
    external: true,
  },
];
---

<section class="ways-section home-gutter" aria-labelledby="ways-heading">
  <div class="home-column">
    <p class="ways-marker">04 / Ways in</p>
    <div class="ways-header">
      <h2 id="ways-heading" class="ways-heading">
        <span class="ways-heading-plain">Bring what you have.</span>
        <span class="ways-heading-accent">Leave with more.</span>
      </h2>
      <p class="ways-aside">Something for every kind of curious.</p>
    </div>
    <ul class="ways-grid">
      {ways.map((way) => (
        <li class="ways-card-wrap">
          <a
            class="ways-card"
            href={way.href}
            target={way.external ? '_blank' : undefined}
            rel={way.external ? 'noopener noreferrer' : undefined}
          >
            <span class="ways-card-number">{way.number}</span>
            <h3 class="ways-card-title">{way.title}</h3>
            <p class="ways-card-copy">{way.description}</p>
            <span class="ways-card-arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  @font-face {
    font-family: 'Playfair Display';
    font-style: italic;
    font-weight: 500;
    font-display: swap;
    src: url('https://fonts.gstatic.com/s/playfairdisplay/v37/nuFrD-vYSZviVYUb_rj3ij__anPXDTlhI4VlFdGjZQ.woff2') format('woff2');
  }

  .ways-section {
    padding-top: 3rem;
    padding-bottom: 3.5rem;
    background: var(--color-base-100);
    color: var(--color-base-content);
  }

  .ways-marker {
    margin: 0 0 1.25rem;
    color: var(--color-primary);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .ways-header {
    display: grid;
    gap: 1rem 3rem;
    margin-bottom: 2rem;
  }

  .ways-heading {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    line-height: 1.08;
  }

  .ways-heading-plain {
    color: var(--color-base-content);
    font-size: clamp(1.85rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .ways-heading-accent {
    color: var(--color-primary);
    font-family: 'Playfair Display', Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-weight: 500;
    font-size: clamp(2rem, 4.4vw, 3.15rem);
    letter-spacing: -0.02em;
  }

  .ways-aside {
    margin: 0;
    max-width: 14rem;
    color: var(--color-base-content);
    opacity: 0.55;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .ways-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ways-card-wrap {
    margin: 0;
  }

  .ways-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 14rem;
    padding: 1.5rem 1.35rem;
    border-radius: 0.75rem;
    border: 1px solid color-mix(in oklab, var(--color-base-content) 12%, transparent);
    background: var(--color-base-200);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .ways-card:hover {
    border-color: color-mix(in oklab, var(--color-primary) 55%, transparent);
    transform: translateY(-2px);
  }

  .ways-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .ways-card-number {
    display: block;
    margin-bottom: 1.25rem;
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .ways-card-title {
    margin: 0 0 0.55rem;
    color: var(--color-base-content);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .ways-card-copy {
    margin: 0 0 1.5rem;
    color: var(--color-base-content);
    opacity: 0.55;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .ways-card-arrow {
    margin-top: auto;
    color: var(--color-primary);
    font-size: 1.1rem;
    line-height: 1;
  }

  @media (min-width: 768px) {
    .ways-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  @media (min-width: 900px) {
    .ways-section {
      padding-top: 4.5rem;
      padding-bottom: 5rem;
    }

    .ways-header {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      margin-bottom: 2.5rem;
    }

    .ways-aside {
      padding-bottom: 0.35rem;
    }

    .ways-card {
      padding: 1.75rem 1.6rem;
      min-height: 16rem;
    }
  }
</style>
