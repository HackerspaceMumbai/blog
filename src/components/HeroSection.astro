---
import CTAButton from './CTAButton.astro';
import { Picture } from 'astro:assets';
import type { PremiereHeroConfig } from '../utils/premiere.js';
import { getPremiereTimeBounds, resolvePremiereState } from '../utils/premiere.js';

interface Props {
  heroImage: ImageMetadata;
  featuredPremiere?: PremiereHeroConfig | null;
}

const { heroImage, featuredPremiere = null } = Astro.props as Props;

const premiereBounds = getPremiereTimeBounds(featuredPremiere);
const hasPremiere = Boolean(premiereBounds && featuredPremiere?.enabled);
const initialState = resolvePremiereState(featuredPremiere);

const premiereTitle = featuredPremiere?.title ?? 'Featured Speaker Session';
const premiereSubtitle = featuredPremiere?.subtitle ?? 'Join the Hackerspace Mumbai community for this special session.';
const watchUrl = featuredPremiere?.watchUrl ?? '#events';
const notifyUrl = featuredPremiere?.notifyUrl ?? watchUrl;
const watchButtonText = featuredPremiere?.watchButtonText ?? 'Watch on YouTube';
const notifyButtonText = featuredPremiere?.notifyButtonText ?? 'Notify Me';
const liveButtonText = featuredPremiere?.liveButtonText ?? 'Join Live Stream';
const liveBadgeText = featuredPremiere?.liveBadgeText ?? 'LIVE NOW';
const upcomingBadgeText = featuredPremiere?.upcomingBadgeText ?? 'LIVE PREMIERE';
---

<section
  class="hero premiere-hero py-16 px-4 text-center relative"
  style={`background-image: linear-gradient(rgba(2, 6, 23, 0.78), rgba(2, 6, 23, 0.92)), url(${heroImage.src}); background-size: cover; background-position: center; background-repeat: no-repeat;`}
  aria-label="Hackerspace Mumbai community hero section"
  data-premiere-hero
  data-has-premiere={hasPremiere ? 'true' : 'false'}
  data-start-at={premiereBounds ? String(premiereBounds.startMs) : undefined}
  data-end-at={premiereBounds ? String(premiereBounds.endMs) : undefined}
>
  <div class="max-w-5xl mx-auto relative z-10">
    <div
      data-hero-state="upcoming"
      class={`premiere-state-card ${initialState === 'upcoming' && hasPremiere ? '' : 'hidden'}`}
      aria-hidden={initialState === 'upcoming' && hasPremiere ? 'false' : 'true'}
    >
      <div class="premiere-pill premiere-pill-upcoming mb-6 mx-auto inline-flex">
        <span aria-hidden="true">📡</span>
        <span>{upcomingBadgeText}</span>
      </div>
      <p
        class="premiere-countdown"
        data-countdown-target
        role="timer"
        aria-live="polite"
      >
        00d : 00h : 00m : 00s
      </p>
      <h1 class="text-4xl md:text-6xl font-bold mb-4 text-white drop-shadow-lg">{premiereTitle}</h1>
      <p class="text-lg md:text-2xl text-base-100/90 mb-8">{premiereSubtitle}</p>
      <div class="flex flex-wrap justify-center gap-4">
        <CTAButton href={watchUrl} target="_blank" variant="primary">{watchButtonText}</CTAButton>
        <CTAButton href={notifyUrl} target="_blank" variant="soft">{notifyButtonText}</CTAButton>
      </div>
      <p class="sr-only" data-countdown-accessibility></p>
    </div>

    <div
      data-hero-state="live"
      class={`premiere-state-card ${initialState === 'live' && hasPremiere ? '' : 'hidden'}`}
      aria-hidden={initialState === 'live' && hasPremiere ? 'false' : 'true'}
    >
      <div class="premiere-pill premiere-pill-live mb-6 mx-auto inline-flex">
        <span aria-hidden="true">🔴</span>
        <span>{liveBadgeText}</span>
      </div>
      <h1 class="text-4xl md:text-6xl font-bold mb-4 text-white drop-shadow-lg">{premiereTitle}</h1>
      <p class="text-lg md:text-2xl text-base-100/90 mb-8">
        {premiereSubtitle}
      </p>
      <div class="flex justify-center">
        <CTAButton href={watchUrl} target="_blank" variant="primary">{liveButtonText}</CTAButton>
      </div>
    </div>

    <div
      data-hero-state="post"
      class={`premiere-state-card ${initialState === 'post' || !hasPremiere ? '' : 'hidden'}`}
      aria-hidden={initialState === 'post' || !hasPremiere ? 'false' : 'true'}
    >
      <figure class="mb-6 w-full max-h-72 object-cover rounded-xl shadow-lg mx-auto overflow-hidden">
        <Picture
          src={heroImage}
          alt="Hackerspace Mumbai community event"
          class="w-full max-h-72 object-cover rounded-xl shadow-lg mx-auto"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          widths={[480, 640, 800, 1200]}
          sizes="(max-width: 640px) 480px, (max-width: 768px) 640px, (max-width: 1024px) 800px, 1200px"
          width={800}
          height={288}
          formats={['avif', 'webp', 'jpeg']}
          quality={75}
        />
      </figure>
      <h1 class="text-4xl md:text-6xl font-bold mb-4">Hackerspace Mumbai</h1>
      <p class="text-xl md:text-2xl mb-8">Mumbai's largest open source community & longest-running tech meetup</p>
      <div class="flex flex-wrap justify-center gap-4 mb-4">
        <CTAButton href="#events" variant="primary">Attend #mumtechup</CTAButton>
        <CTAButton href="#join" variant="soft">Join Community</CTAButton>
      </div>
      <div class="flex justify-center space-x-4">
        <a href="https://twitter.com/hackmum" target="_blank" rel="noopener" aria-label="Follow Hackerspace Mumbai on Twitter">
          <svg class="w-6 h-6 text-accent" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"></path></svg>
        </a>
        <a href="https://github.com/HackerspaceMumbai" target="_blank" rel="noopener" aria-label="View Hackerspace Mumbai projects on GitHub">
          <svg class="w-6 h-6 text-accent" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path></svg>
        </a>
        <a href="https://linkedin.com/company/hackerspace-mumbai" target="_blank" rel="noopener" aria-label="Connect with Hackerspace Mumbai on LinkedIn">
          <svg class="w-6 h-6 text-accent" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd"></path></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const heroRoot = document.querySelector('[data-premiere-hero]');
    if (!(heroRoot instanceof HTMLElement)) return;
    if (heroRoot.dataset.hasPremiere !== 'true') return;

    const startMs = Number(heroRoot.dataset.startAt);
    const endMs = Number(heroRoot.dataset.endAt);
    if (!Number.isFinite(startMs) || !Number.isFinite(endMs) || endMs <= startMs) return;

    const statePanels = heroRoot.querySelectorAll('[data-hero-state]');
    const countdownEl = heroRoot.querySelector('[data-countdown-target]');
    const countdownA11yEl = heroRoot.querySelector('[data-countdown-accessibility]');

    const resolveState = (nowMs) => {
      if (nowMs < startMs) return 'upcoming';
      if (nowMs < endMs) return 'live';
      return 'post';
    };

    const formatCountdown = (remainingMs) => {
      const safeRemainingMs = Math.max(0, remainingMs);
      const totalSeconds = Math.floor(safeRemainingMs / 1000);
      const days = Math.floor(totalSeconds / 86400);
      const hours = Math.floor((totalSeconds % 86400) / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;

      return `${String(days).padStart(2, '0')}d : ${String(hours).padStart(2, '0')}h : ${String(minutes).padStart(2, '0')}m : ${String(seconds).padStart(2, '0')}s`;
    };

    const applyState = (state) => {
      statePanels.forEach((panel) => {
        const isCurrentState = panel.dataset.heroState === state;
        panel.classList.toggle('hidden', !isCurrentState);
        panel.setAttribute('aria-hidden', isCurrentState ? 'false' : 'true');
      });
    };

    let countdownIntervalId = null;

    const tick = () => {
      const nowMs = Date.now();
      const state = resolveState(nowMs);
      applyState(state);

      if (state === 'post' && countdownIntervalId !== null) {
        window.clearInterval(countdownIntervalId);
        countdownIntervalId = null;
      }

      if (countdownEl && state === 'upcoming') {
        const remainingMs = startMs - nowMs;
        const formattedCountdown = formatCountdown(remainingMs);
        countdownEl.textContent = formattedCountdown;
        if (countdownA11yEl) {
          countdownA11yEl.textContent = `Premiere starts in ${formattedCountdown.replace(/ : /g, ', ')}`;
        }
      }
    };

    tick();
    if (resolveState(Date.now()) !== 'post') {
      countdownIntervalId = window.setInterval(tick, 1000);
    }
  })();
</script>

<style>
  .premiere-hero {
    min-height: 32rem;
    display: flex;
    align-items: center;
  }

  .premiere-state-card {
    border-radius: 1rem;
    padding: 1.5rem;
    backdrop-filter: blur(4px);
  }

  .premiere-pill {
    gap: 0.5rem;
    align-items: center;
    border-radius: 9999px;
    font-weight: 700;
    letter-spacing: 0.03em;
    padding: 0.45rem 0.9rem;
    font-size: 0.875rem;
    text-transform: uppercase;
    border: 1px solid transparent;
  }

  .premiere-pill-upcoming {
    background: linear-gradient(120deg, rgba(255, 193, 7, 0.92), rgba(255, 179, 0, 0.85));
    color: #2a1a00;
    box-shadow: 0 8px 24px rgba(255, 193, 7, 0.25);
  }

  .premiere-pill-live {
    background: rgba(220, 38, 38, 0.92);
    color: #fff5f5;
    border-color: rgba(248, 113, 113, 0.6);
    box-shadow: 0 8px 24px rgba(220, 38, 38, 0.3);
  }

  .premiere-countdown {
    background: rgba(2, 6, 23, 0.62);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 0.85rem;
    color: #f8fafc;
    display: inline-block;
    font-family: ui-monospace, SFMono-Regular, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    font-size: clamp(1.5rem, 5vw, 3.8rem);
    letter-spacing: 0.04em;
    margin-bottom: 1.75rem;
    padding: 0.8rem 1.25rem;
  }

  @media (max-width: 768px) {
    .premiere-hero {
      min-height: 28rem;
    }

    .premiere-state-card {
      padding: 1rem;
    }

    .premiere-countdown {
      width: 100%;
      font-size: clamp(1.2rem, 7vw, 2.2rem);
      padding: 0.7rem 0.9rem;
      letter-spacing: 0.02em;
    }
  }
</style>
