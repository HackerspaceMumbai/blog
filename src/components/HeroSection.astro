---
import CTAButton from './CTAButton.astro';
import { Picture } from 'astro:assets';
import type { PremiereHeroConfig } from '../utils/premiere.js';
import { getPremiereTimeBounds, resolvePremiereState } from '../utils/premiere.js';

interface Props {
  heroImage: ImageMetadata;
  featuredPremiere?: PremiereHeroConfig | null;
}

const { heroImage, featuredPremiere = null } = Astro.props as Props;

const premiereBounds = getPremiereTimeBounds(featuredPremiere);
const hasPremiere = Boolean(premiereBounds && featuredPremiere?.enabled);
const initialState = resolvePremiereState(featuredPremiere);

const premiereTitle = featuredPremiere?.title ?? 'Featured Speaker Session';
const premiereSubtitle = featuredPremiere?.subtitle ?? 'Join the Hackerspace Mumbai community for this special session.';
const watchUrl = featuredPremiere?.watchUrl ?? '#events';
const notifyUrl = featuredPremiere?.notifyUrl ?? watchUrl;
const watchButtonText = featuredPremiere?.watchButtonText ?? 'Watch on YouTube';
const notifyButtonText = featuredPremiere?.notifyButtonText ?? 'Notify Me';
const liveButtonText = featuredPremiere?.liveButtonText ?? 'Join Live Stream';
const liveBadgeText = featuredPremiere?.liveBadgeText ?? 'LIVE NOW';
const upcomingBadgeText = featuredPremiere?.upcomingBadgeText ?? 'LIVE PREMIERE';
---

<section
  class="premiere-hero relative bg-base-100 text-base-content home-gutter"
  aria-label="Hackerspace Mumbai community hero section"
  data-premiere-hero
  data-has-premiere={hasPremiere ? 'true' : 'false'}
  data-start-at={premiereBounds ? String(premiereBounds.startMs) : undefined}
  data-end-at={premiereBounds ? String(premiereBounds.endMs) : undefined}
>
  <div
    data-hero-state="upcoming"
    class={`premiere-state-card text-center max-w-5xl mx-auto relative z-10 ${initialState === 'upcoming' && hasPremiere ? '' : 'hidden'}`}
    aria-hidden={initialState === 'upcoming' && hasPremiere ? 'false' : 'true'}
  >
    <div class="premiere-pill premiere-pill-upcoming mb-6 mx-auto inline-flex">
      <span aria-hidden="true">📡</span>
      <span>{upcomingBadgeText}</span>
    </div>
    <p
      class="premiere-countdown"
      data-countdown-target
      role="timer"
    >
      00d : 00h : 00m : 00s
    </p>
    <h1 class="text-4xl md:text-6xl font-bold mb-4 text-white drop-shadow-lg">{premiereTitle}</h1>
    <p class="text-lg md:text-2xl text-base-content/90 mb-8">{premiereSubtitle}</p>
    <div class="flex flex-wrap justify-center gap-4">
      <CTAButton href={watchUrl} target="_blank" variant="primary">{watchButtonText}</CTAButton>
      <CTAButton href={notifyUrl} target="_blank" variant="soft">{notifyButtonText}</CTAButton>
    </div>
    <p class="sr-only" data-countdown-accessibility></p>
  </div>

  <div
    data-hero-state="live"
    class={`premiere-state-card text-center max-w-5xl mx-auto relative z-10 ${initialState === 'live' && hasPremiere ? '' : 'hidden'}`}
    aria-hidden={initialState === 'live' && hasPremiere ? 'false' : 'true'}
  >
    <div class="premiere-pill premiere-pill-live mb-6 mx-auto inline-flex">
      <span aria-hidden="true">🔴</span>
      <span>{liveBadgeText}</span>
    </div>
    <h1 class="text-4xl md:text-6xl font-bold mb-4 text-white drop-shadow-lg">{premiereTitle}</h1>
    <p class="text-lg md:text-2xl text-base-content/90 mb-8">
      {premiereSubtitle}
    </p>
    <div class="flex justify-center">
      <CTAButton href={watchUrl} target="_blank" variant="primary">{liveButtonText}</CTAButton>
    </div>
  </div>

  <div
    data-hero-state="post"
    class={`hero-split home-column relative z-10 ${initialState === 'post' || !hasPremiere ? '' : 'hidden'}`}
    aria-hidden={initialState === 'post' || !hasPremiere ? 'false' : 'true'}
  >
    <div class="hero-copy">
      <p class="hero-overline text-primary">A community for curious people</p>
      <h1 class="hero-heading">
        <span class="hero-heading-primary text-base-content">Build the future.</span>
        <span class="hero-heading-accent text-primary">Together.</span>
      </h1>
      <p class="hero-lede text-base-content/70">
      Hackerspace Mumbai is the city's largest open-source <span class="text-primary font-medium">#OSS</span> community - a home for builders, generous mentors, and people who believe the best things are made in community. Established in 2011, we've kept Mumbai's longest-running tech meetup, <span class="text-primary font-medium">#mumtechup</span>, moving.      </p>
      <div class="hero-actions">
        <CTAButton href="#join" variant="primary">
          Find your people →
        </CTAButton>
        <CTAButton href="/about/" variant="link">
          See how it works ↗
        </CTAButton>
      </div>
    </div>
    <figure class="hero-photo">
      <Picture
        src={heroImage}
        alt="Community members collaborating around a workshop table at Hackerspace Mumbai"
        class="hero-photo-img"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        widths={[480, 640, 800, 1200]}
        sizes="(max-width: 768px) 100vw, 50vw"
        width={960}
        height={720}
        formats={['avif', 'webp', 'jpeg']}
        quality={80}
      />
    </figure>
  </div>
</section>

<script src="/scripts/premiere-hero.js" defer></script>

<style>
  @font-face {
    font-family: 'Playfair Display';
    font-style: italic;
    font-weight: 500;
    font-display: swap;
    src: url('https://fonts.gstatic.com/s/playfairdisplay/v37/nuFrD-vYSZviVYUb_rj3ij__anPXDTlhI4VlFdGjZQ.woff2') format('woff2');
  }

  .premiere-hero {
    min-height: min(38rem, calc(100vh - 4.5rem));
    display: flex;
    align-items: center;
    padding-top: 3.5rem;
    padding-bottom: 4.5rem;
    text-align: left;
  }

  .hero-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    align-items: center;
  }

  .hero-overline {
    margin: 0 0 1.25rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .hero-heading {
    margin: 0 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    line-height: 0.95;
  }

  .hero-heading-primary {
    font-size: clamp(2.5rem, 6vw, 4.35rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .hero-heading-accent {
    font-family: 'Playfair Display', Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-weight: 500;
    font-size: clamp(2.75rem, 7vw, 4.75rem);
    letter-spacing: -0.02em;
  }

  .hero-lede {
    margin: 0 0 2rem;
    max-width: 34rem;
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 1.75rem;
  }

  .hero-photo {
    margin: 0;
    overflow: hidden;
    border-radius: 0.75rem;
  }

  .hero-photo :global(img),
  .hero-photo-img {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 28rem;
    object-fit: cover;
    border-radius: 0.75rem;
  }

  .premiere-state-card {
    border-radius: 1rem;
    padding: 1.5rem;
  }

  .premiere-pill {
    gap: 0.5rem;
    align-items: center;
    border-radius: 9999px;
    font-weight: 700;
    letter-spacing: 0.03em;
    padding: 0.45rem 0.9rem;
    font-size: 0.875rem;
    text-transform: uppercase;
    border: 1px solid transparent;
  }

  .premiere-pill-upcoming {
    background: linear-gradient(120deg, rgba(255, 193, 7, 0.92), rgba(255, 179, 0, 0.85));
    color: #2a1a00;
    box-shadow: 0 8px 24px rgba(255, 193, 7, 0.25);
  }

  .premiere-pill-live {
    background: rgba(220, 38, 38, 0.92);
    color: #fff5f5;
    border-color: rgba(248, 113, 113, 0.6);
    box-shadow: 0 8px 24px rgba(220, 38, 38, 0.3);
  }

  .premiere-countdown {
    background: rgba(2, 6, 23, 0.62);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 0.85rem;
    color: #f8fafc;
    display: inline-block;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    font-size: clamp(1.5rem, 5vw, 3.8rem);
    letter-spacing: 0.04em;
    margin-bottom: 1.75rem;
    padding: 0.8rem 1.25rem;
  }

  @media (min-width: 900px) {
    .premiere-hero {
      padding-top: 4.5rem;
      padding-bottom: 5.5rem;
    }

    .hero-split {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 4rem;
    }

    .hero-photo :global(img),
    .hero-photo-img {
      max-height: 32rem;
      aspect-ratio: 5 / 4;
    }
  }

  @media (max-width: 768px) {
    .premiere-hero {
      min-height: 0;
      padding: 2.25rem 1.25rem 3rem;
    }

    .premiere-state-card {
      padding: 1rem;
    }

    .premiere-countdown {
      width: 100%;
      font-size: clamp(1.2rem, 7vw, 2.2rem);
      padding: 0.7rem 0.9rem;
      letter-spacing: 0.02em;
    }
  }
</style>
