---
const values = [
  {
    title: 'Everyone was new once',
    description: 'First-timers get a named host, not a badge and a shrug. If you can find the door, you can find a seat.',
  },
  {
    title: "Show, don't pitch",
    description: 'Demos beat decks. Talks are about what you built and what broke, not about what your company sells.',
  },
  {
    title: 'Open by default',
    description: 'Recordings, slides, code, budgets and the handbook are public. The community should be forkable.',
  },
  {
    title: 'Contribution over credential',
    description: 'Nobody is asked where they studied. What you help with is the only résumé that matters here.',
  },
];
---

<section id="about" class="care-section home-gutter" aria-labelledby="about-heading">
  <div class="home-column">
    <p class="care-marker">03 / What we care about</p>
    <h2 id="about-heading" class="care-heading">What we care about</h2>
    <ul class="care-grid">
      {values.map((value) => (
        <li class="care-card">
          <h3 class="care-card-title">{value.title}</h3>
          <p class="care-card-copy">{value.description}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .care-section {
    padding-top: 3rem;
    padding-bottom: 3.5rem;
    background: var(--color-base-100);
    color: var(--color-base-content);
  }

  .care-marker {
    margin: 0 0 1.25rem;
    color: var(--color-primary);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .care-heading {
    margin: 0 0 2rem;
    color: var(--color-base-content);
    font-size: clamp(1.85rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .care-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .care-card {
    margin: 0;
    padding: 1.5rem 1.35rem;
    border-radius: 0.75rem;
    background: var(--color-base-200);
  }

  .care-card-title {
    margin: 0 0 0.7rem;
    color: var(--color-base-content);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .care-card-copy {
    margin: 0;
    color: var(--color-base-content);
    opacity: 0.6;
    font-size: 0.95rem;
    line-height: 1.65;
  }

  @media (min-width: 768px) {
    .care-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .care-card {
      padding: 1.75rem 1.6rem;
    }
  }

  @media (min-width: 900px) {
    .care-section {
      padding-top: 4.5rem;
      padding-bottom: 5rem;
    }

    .care-heading {
      margin-bottom: 2.5rem;
    }
  }
</style>
