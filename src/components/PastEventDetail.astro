---
import { Image } from 'astro:assets';
import SessionResourceCard from './SessionResourceCard.astro';
import {
  getExternalMediaLinks,
  groupResourcesBySession,
  isSafeArchiveUrl,
  type PastEventArchiveLinks,
  type ArchiveSpeakerResource,
} from '../utils/pastEventArchive';
import { resolveResourceUrl, getEventSlug, isValidResourceUrl } from '../utils/resourceUrl';
import type { ImageMetadata } from 'astro';

export interface EventHighlight {
  label: string;
  value: string;
}

export interface PastEventDetailProps {
  title: string;
  date: Date;
  location: string;
  description: string;
  speakerResources?: ArchiveSpeakerResource[];
  coverImage?: ImageMetadata;
  eventId?: string;
  slug?: string;
  archiveLinks?: PastEventArchiveLinks;
  highlights?: EventHighlight[];
  recapPostSlug?: string;
  recapExcerpt?: string;
}

const {
  title,
  date,
  location,
  description,
  speakerResources = [],
  coverImage,
  eventId = '',
  slug = '',
  archiveLinks,
  highlights = [],
  recapPostSlug,
  recapExcerpt,
} = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);

const eventSlug = getEventSlug(eventId);
const resolvedResources = speakerResources
  .filter((resource) => isValidResourceUrl(resource.resourceUrl))
  .map((resource) => ({
    ...resource,
    resourceUrl: resolveResourceUrl(resource.resourceUrl, eventSlug),
  }))
  .filter((resource) => resource.resourceUrl);

const sessions = groupResourcesBySession(resolvedResources);

const canonicalArchiveUrl = isSafeArchiveUrl(archiveLinks?.archiveUrl)
  ? archiveLinks.archiveUrl
  : undefined;

const videosUrl = isSafeArchiveUrl(archiveLinks?.videosUrl)
  ? archiveLinks.videosUrl
  : undefined;

const mediaLinks = getExternalMediaLinks(archiveLinks).filter(
  (link) => link.label === 'Browse Videos' || link.label === 'Open Media Archive'
);

const showRecap = Boolean(recapPostSlug && recapExcerpt?.trim());
const recapHref = showRecap ? `/blog/${recapPostSlug}/` : undefined;
const galleryHref = slug ? `/past-events/${slug}/gallery/` : undefined;
const hasHighlights = highlights.length > 0;
const hasMedia = Boolean(galleryHref || videosUrl || mediaLinks.length > 0);
---

<article class="space-y-10" aria-labelledby="past-event-detail-title">
  <!-- Hero -->
  <header class="rounded-xl border border-base-300 bg-base-100 overflow-hidden">
    {coverImage && (
      <figure class="relative w-full h-56 sm:h-72 overflow-hidden bg-base-200">
        <Image
          src={coverImage}
          alt={title}
          class="w-full h-full object-cover"
          loading="eager"
          widths={[400, 600, 800, 1200]}
          sizes="(max-width: 640px) 400px, (max-width: 1024px) 800px, 1200px"
          format="webp"
          quality={80}
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent pointer-events-none"></div>
      </figure>
    )}

    <div class="p-6 sm:p-8">
      <time datetime={date.toISOString()} class="text-sm font-semibold text-primary">
        {formattedDate}
      </time>

      <h2 id="past-event-detail-title" class="mt-2 text-3xl sm:text-4xl font-bold text-base-content">
        {title}
      </h2>

      <p class="mt-3 text-sm text-base-content/70 flex items-start gap-2">
        <svg class="w-4 h-4 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
        </svg>
        <span>{location}</span>
      </p>

      <p class="mt-4 text-base text-base-content/80 max-w-3xl">
        {description}
      </p>

      {(showRecap || galleryHref || canonicalArchiveUrl) && (
        <div class="mt-6 flex flex-wrap gap-3">
          {showRecap && recapHref && (
            <a
              href={recapHref}
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-primary text-primary-content hover:bg-primary-focus transition-colors duration-300 font-medium"
            >
              Read Recap
            </a>
          )}

          {galleryHref && (
            <a
              href={galleryHref}
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-primary text-primary hover:bg-primary hover:text-primary-content transition-colors duration-300"
              aria-label="View photos from this event"
            >
              View Photos
            </a>
          )}

          {canonicalArchiveUrl && (
            <a
              href={canonicalArchiveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-base-300 text-base-content hover:border-primary hover:text-primary transition-colors duration-300"
              aria-label="Open canonical event archive on GitHub"
            >
              Archive
            </a>
          )}
        </div>
      )}
    </div>
  </header>

  <!-- Highlights -->
  {hasHighlights && (
    <section aria-labelledby="event-highlights-heading">
      <h3 id="event-highlights-heading" class="text-xl font-bold text-base-content mb-4">
        Event Highlights
      </h3>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        {highlights.map((item) => (
          <div class="rounded-xl border border-base-300 bg-base-100 px-4 py-5 text-center">
            <p class="text-2xl font-bold text-primary">{item.value}</p>
            <p class="mt-1 text-sm text-base-content/70">{item.label}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Recap teaser -->
  {showRecap && recapHref && (
    <section
      class="rounded-xl border border-base-300 bg-base-100 p-6 sm:p-8"
      aria-labelledby="event-recap-heading"
    >
      <h3 id="event-recap-heading" class="text-xl font-bold text-base-content mb-3">
        Event Recap
      </h3>
      <p class="text-base text-base-content/80 mb-4 max-w-3xl">
        {recapExcerpt}
      </p>
      <a
        href={recapHref}
        class="inline-flex items-center gap-1 font-medium text-primary hover:text-primary-focus hover:underline focus:outline-none focus:ring-2 focus:ring-primary rounded"
      >
        Read Full Recap
        <span aria-hidden="true">→</span>
      </a>
    </section>
  )}

  <!-- Sessions -->
  {sessions.length > 0 && (
    <section aria-labelledby="event-sessions-heading">
      <h3 id="event-sessions-heading" class="text-xl font-bold text-base-content mb-4">
        Sessions
      </h3>
      <div class="grid gap-4">
        {sessions.map((session) => (
          <SessionResourceCard session={session} />
        ))}
      </div>
    </section>
  )}

  <!-- Media -->
  {hasMedia && (
    <section
      class="rounded-xl border border-base-300 bg-base-100 p-6 sm:p-8"
      aria-labelledby="event-media-heading"
    >
      <h3 id="event-media-heading" class="text-xl font-bold text-base-content mb-3">
        Media Gallery
      </h3>
      <p class="text-sm text-base-content/70 mb-4">
        Photos and videos from the event.
      </p>
      <div class="flex flex-wrap gap-3">
        {galleryHref && (
          <a
            href={galleryHref}
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-primary text-primary hover:bg-primary hover:text-primary-content transition-colors"
          >
            Photos
          </a>
        )}
        {videosUrl && (
          <a
            href={videosUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-base-300 text-base-content hover:border-primary hover:text-primary transition-colors"
          >
            Videos
          </a>
        )}
        {!videosUrl && mediaLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-base-300 text-base-content hover:border-primary hover:text-primary transition-colors"
          >
            {link.label}
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Canonical Archive -->
  {canonicalArchiveUrl && (
    <section
      class="rounded-xl border border-base-300 bg-base-100 p-6 sm:p-8"
      aria-labelledby="event-archive-heading"
    >
      <h3 id="event-archive-heading" class="text-xl font-bold text-base-content mb-3">
        Canonical Archive
      </h3>
      <p class="text-sm text-base-content/70 mb-4 max-w-2xl">
        Browse the complete event archive in the HackerspaceMumbai/events repository.
      </p>
      <a
        href={canonicalArchiveUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-primary text-primary hover:bg-primary hover:text-primary-content transition-colors"
        aria-label="Open canonical event archive on GitHub"
      >
        Open Archive
      </a>
    </section>
  )}
</article>
