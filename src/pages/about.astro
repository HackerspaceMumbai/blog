---
import Layout from "../components/Layout.astro";
import AboutSection from "../components/AboutSection.astro";
import CTAButton from "../components/CTAButton.astro";

const FOUNDED_YEAR = 2011;
const yearsRunning = new Date().getFullYear() - FOUNDED_YEAR;

export const title = "About Us - Hackerspace Mumbai";
export const description =
  "Hackerspace Mumbai was founded in 2011 on a simple belief: technology grows when people share what they know. Learn about our mission and community.";
export const tags = ["about", "community", "open source", "mumbai", "hackerspace"];
export const canonical = "https://hackmum.in/about";
---

<Layout
  title={title}
  description={description}
  tags={tags}
  canonical={canonical}
  type="website"
>
  <article class="about-page home-gutter" aria-labelledby="about-us-heading">
    <div class="about-inner home-column">
      <nav class="about-breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-current="page">About</li>
        </ol>
      </nav>

      <p class="about-kicker">Our story</p>
      <h1 id="about-us-heading" class="about-heading">
        <span class="about-heading-plain">Hackerspace Mumbai was founded in {FOUNDED_YEAR} with a simple belief:</span>
        <span class="about-heading-accent">Technology grows when people share what they know.</span>
      </h1>

      <div class="about-copy">
        <p>
          Over the last {yearsRunning}+ years, we have brought together developers, students, architects, designers, founders, open-source contributors, and lifelong learners to learn, build, and grow together.
        </p>
        <p>
          Our mission is to create opportunities for people to connect, contribute, and thrive through open-source principles and community-driven learning.
        </p>
      </div>

      <div class="about-actions">
        <CTAButton href="/events/" variant="primary">Browse events →</CTAButton>
        <CTAButton href="mailto:community@hackmum.in" variant="link">Email us</CTAButton>
      </div>
    </div>
  </article>

  <AboutSection />
</Layout>

<style>
  .about-page {
    padding-top: 2.5rem;
    padding-bottom: 1rem;
    background: var(--color-base-100);
    color: var(--color-base-content);
  }

  .about-breadcrumb {
    margin-bottom: 1.25rem;
  }

  .about-breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.85rem;
  }

  .about-breadcrumb li:not(:last-child)::after {
    content: '/';
    margin-left: 0.5rem;
    color: color-mix(in oklab, var(--color-base-content) 40%, transparent);
  }

  .about-breadcrumb a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .about-breadcrumb a:hover {
    text-decoration: underline;
  }

  .about-kicker {
    margin: 0 0 1rem;
    color: var(--color-primary);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .about-heading {
    margin: 0 0 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    max-width: 42rem;
    line-height: 1.12;
  }

  .about-heading-plain {
    color: var(--color-base-content);
    font-size: clamp(1.45rem, 3vw, 2.15rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .about-heading-accent {
    color: var(--color-primary);
    font-family: 'Playfair Display', Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.85rem, 4vw, 2.85rem);
    letter-spacing: -0.02em;
  }

  .about-copy {
    max-width: 40rem;
  }

  .about-copy p {
    margin: 0 0 1.15rem;
    color: var(--color-base-content);
    opacity: 0.78;
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .about-copy p:last-child {
    margin-bottom: 0;
  }

  .about-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 2rem;
  }
</style>
