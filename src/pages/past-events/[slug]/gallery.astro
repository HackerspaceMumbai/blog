---
import Layout from "../../../components/Layout.astro";
import EventGallery from "../../../components/EventGallery.astro";
import { getCollection } from "astro:content";
import { getExternalMediaLinks, getGitHubArchivePhotoImages, enrichPastEventFromArchive } from "../../../utils/pastEventArchive";

const pastEventCollection = await getCollection("pastEvents");
const { slug } = Astro.params;

if (typeof slug !== 'string') {
  return new Response("Past event not found", { status: 404 });
}

const event = pastEventCollection.find(
  (entry) => entry.id.replace(/\/index$/, '') === slug
);

if (!event) {
  return new Response("Past event not found", { status: 404 });
}

const enriched = await enrichPastEventFromArchive(event.data.archiveLinks, {
  title: event.data.title,
  date: event.data.date,
  location: event.data.location,
  description: event.data.description,
  speakerResources: event.data.speakerResources,
});

// Map past event slugs to their image folder paths
// Example: "april-2026-github-copilot-dev-days" -> "april-2026-github-copilot-dev-days"
const imageFolderSlug = slug;

// Dynamically import all images from the event's photos folder
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/events/*/photos/*.{[jJ][pP][gG],[jJ][pP][eE][gG],[pP][nN][gG],[gG][iI][fF],[wW][eE][bB][pP],[aA][vV][iI][fF]}",
  { eager: true }
);

const imageEntries = Object.entries(images) as Array<[string, { default: ImageMetadata }]>;

// Filter and organize images for this specific past event
const eventImages = imageEntries
  .filter(([path]) => path.includes(`/events/${imageFolderSlug}/photos/`))
  .sort(([pathA], [pathB]) => pathA.localeCompare(pathB))
  .map(([path, image]) => {
    const filename = path.split("/").pop() || "Photo";
    return {
      src: image.default,
      alt: `${enriched.title} - ${filename}`,
    };
  });

const externalPhotoImages = eventImages.length === 0
  ? await getGitHubArchivePhotoImages(event.data.archiveLinks?.photosUrl, enriched.title)
  : [];
const galleryImages = eventImages.length > 0 ? eventImages : externalPhotoImages;
const externalMediaLinks = getExternalMediaLinks(event.data.archiveLinks);
// Create breadcrumb navigation
const breadcrumb = [
  { label: "Home", href: "/" },
  { label: "Past Events", href: "/past-events" },
  { label: enriched.title, href: `/past-events/${slug}` },
];

const title = `${enriched.title} - Photo Gallery`;
const description = `Photos from ${enriched.title} at Hackerspace Mumbai`;
---

<Layout
  title={title}
  description={description}
  tags={["event", "gallery", "photos", "past-event", slug]}
  canonical={`https://hackmum.in/past-events/${slug}/gallery`}
  type="website"
>
  <!-- Page heading for screen readers -->
  <h1 class="sr-only">{enriched.title} Gallery</h1>

  <EventGallery
    eventTitle={enriched.title}
    eventSlug={slug}
    images={galleryImages}
    externalMediaLinks={externalMediaLinks}
    breadcrumb={breadcrumb}
    backLink={{ label: "Back to Event", href: `/past-events/${slug}` }}
  />
</Layout>
