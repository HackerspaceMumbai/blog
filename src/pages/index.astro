---
import Layout from "../components/Layout.astro";
import HeroSection from "../components/HeroSection.astro";
import heroBackground from '../assets/images/hero_background.jpg';
import AboutSection from "../components/AboutSection.astro";
import NewsletterSection from "../components/NewsletterSection.astro";
import CommunityIntro from "../components/CommunityIntro.astro";
import FeaturedEventBanner from "../components/FeaturedEventBanner.astro";
import CommunityMetrics from "../components/CommunityMetrics.astro";
import IdeaSection from "../components/IdeaSection.astro";
import PathSection from "../components/PathSection.astro";
import WaysInSection from "../components/WaysInSection.astro";
import QuoteSection from "../components/QuoteSection.astro";
import CloseCtaSection from "../components/CloseCtaSection.astro";
import SupportedBy from "../components/SupportedBy.astro";
import { FEATURED_PREMIERE } from "../data/featuredPremiere.js";
import { FEATURED_HOME_EVENT } from "../data/upcomingEvents.js";
import featuredEventImage from "../assets/images/events/dev-days-mumbai-2026.png";

const FOUNDED_YEAR = 2011;
const NEW_MEMBERS_THIS_MONTH = 113;
const stats = {
  yearsRunning: new Date().getFullYear() - FOUNDED_YEAR,
  meetupsHosted: 111,
  membersCount: "5,000+",
  projectsSupported: 60,
};

export const title = "Hackerspace Mumbai - Mumbai's Largest Open Source Community";
export const description = "Mumbai's largest open-source community in Mumbai, hosting the city's longest-running tech meetup. Join us for events, workshops, and collaborative learning!";
export const tags = ["open source", "mumbai", "tech meetup", "developers", "community", "programming", "hackathon", "workshops"];
export const canonical = "https://hackmum.in/";
---

<Layout 
  title={title} 
  description={description}
  tags={tags}
  canonical={canonical}
  type="website"
>
  <HeroSection
    heroImage={heroBackground}
    featuredPremiere={FEATURED_PREMIERE}
    newMembersThisMonth={NEW_MEMBERS_THIS_MONTH}
  />

  <FeaturedEventBanner
    title={FEATURED_HOME_EVENT.title}
    date={FEATURED_HOME_EVENT.date}
    location={FEATURED_HOME_EVENT.location}
    description={FEATURED_HOME_EVENT.description}
    rsvpLink={FEATURED_HOME_EVENT.rsvpLink}
    image={featuredEventImage}
    kicker="Upcoming event"
  />

  <CommunityIntro />

  <CommunityMetrics stats={stats} />

  <IdeaSection />

  <PathSection />

  <AboutSection />

  <WaysInSection />

  <QuoteSection />

  <CloseCtaSection />

  <NewsletterSection />

  <SupportedBy />
</Layout>
